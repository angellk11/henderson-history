---
// src/pages/subjects/index.astro
import fs from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const raw: any[] = JSON.parse(
  await fs.readFile(path.resolve(process.cwd(), 'data/build/staffRoles.json'), 'utf-8')
);
const items = raw
  .map((r) => r?.staffRole ?? r)
  .filter((s) => s?.staffRoleSlug)
  .sort((a: any, b: any) => a.staffRoleName.localeCompare(b.staffRoleName));
---
<BaseLayout title="Staff Roles" description="All subjects taught at the college.">
  <h1>Staff Roles</h1>
  <ul class="rows">
    {items.map((s: any) => (
      <li><a href={`/staff-roles/${s.staffRoleSlug}`}>{s.staffRoleName}</a></li>
    ))}
  </ul>
  <style>
    .rows { columns: 2; list-style: none; padding: 0; }
    @media (min-width: 60rem) { .rows { columns: 4; } }
  </style>
</BaseLayout>
